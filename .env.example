# Copier en .env.local (jamais dans Git) et remplir. Sur Vercel : Settings → Environment Variables.

# Adresses
APP_URL=https://compte.agencejutras.com
SITE_URL=https://www.agencejutras.com

# Session : une longue chaîne aléatoire, 32 caractères ou plus
SESSION_SECRET=

# Les courriels qui ont accès à la console, séparés par des virgules
ADMIN_COURRIELS=alexis@agencejutras.com

# Courriels (Resend)
RESEND_API_KEY=
COURRIEL_EXPEDITEUR=Agence Jutras <compte@agencejutras.com>

# Base de données (Supabase, région Canada, projet séparé de Kairos) — à brancher
SUPABASE_URL=
SUPABASE_SECRET_KEY=
